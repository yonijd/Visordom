{
  "manifest_version": 3,
  "name": "VisorDOM",
  "version": "0.4",
  "description": "Inspector universal de DOM con escaneo progresivo",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VisorDOM Opciones",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["visordom.js"],
      "run_at": "document_idle"
    }
  ]
}